{#
/**
 * @file
 * Renders the /donate/success and /donate/cancel status pages.
 *
 * Available variables:
 * - status: Machine name of the current status (succeeded, pending, etc).
 * - heading: Translated heading text.
 * - message: Translated body text.
 * - donation: The donation row object, or NULL if not resolved.
 * - reference: Pre-formatted human-facing reference (e.g. DON-000123).
 * - try_again_url: Optional URL to retry the donation.
 */
#}
<div class="simple-stripe-donation-status simple-stripe-donation-status--{{ status }}">
  <div class="simple-stripe-donation-status__icon" aria-hidden="true">
    {% if status in ['succeeded', 'confirmed_pending_webhook'] %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7" /></svg>
    {% elseif status in ['failed', 'expired', 'unknown'] %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
    {% elseif status == 'refunded' %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10a9 9 0 1 1 2.6 6.4M3 10V4M3 10h6" /></svg>
    {% else %}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
    {% endif %}
  </div>

  <h3>{{ heading }}</h3>
  <p class="simple-stripe-donation-status__message">{{ message }}</p>

  {% if donation and reference and donation.status in ['succeeded', 'refunded'] %}
    <dl class="simple-stripe-donation-status__reference">
      <dt>{{ 'Reference'|t }}</dt>
      <dd>{{ reference }}</dd>
    </dl>
  {% endif %}

  <div class="simple-stripe-donation-status__actions">
    {% if try_again_url %}
      <a class="simple-stripe-donation-status__action simple-stripe-donation-status__action--primary" href="{{ try_again_url }}">{{ 'Try again'|t }}</a>
    {% endif %}
    <a class="simple-stripe-donation-status__action simple-stripe-donation-status__action--secondary" href="{{ path('<front>') }}">{{ 'Return to home page'|t }}</a>
  </div>
</div>
